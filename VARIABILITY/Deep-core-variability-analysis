### We tested for differences in variability with depth and the the SNV frequencies across samples for each MAG.  The steps below provide the details for analysis
### of one MAG. All others were analyzed in the same manner.

    dat <- read.table("~/Documents/DEEP-CORE/VARIABILITY/ANVIO-VARIABILITY-VISUALIZATION/VARIABILITY_s_SalMarSW160130MG_3_8917055_Bin_53-interactive/view.txt", header = TRUE, row.names = 1)

    mdat <- read.table("~/Documents/DEEP-CORE/VARIABILITY/Subsurface-core-mag-mean-and-variability.txt", header = TRUE, row.names = 1)
    # include only the two deepest cores
    deep.dat <-filter(mdat, core == "SW1601" | core == "WE1603")
    # include only samples with more than 15x mean coverage of the MAG
    deep.dat.min15 <- filter(deep.dat, mean > 15)
    # include only MAGs with the coverage in both cores and representative samples throughout most of the depth profile 
    deep.dat.min15.bin53 <- filter(deep.dat.min15, MAG == "s_SalMarSW160130MG_3_8917055_Bin_53")
    # collect the sample names in the filtered data for this mag
    hc_samples <- deep.dat.min15.bin53$sample
    # filter the dta to include on those samples
    data_to_keep <- dat[, hc_samples]
    dat_filtered <- data_to_keep %>%
      filter(rowSums(across(everything())) != 0)

    # compute the distance matrix from the SNV frequency table
    dist <- vegdist(t(dat_filtered), method = "bray")
    # test for differences in dispersion between cores
    bdisp <- betadisper(dist, group = deep.dat.min15.bin53$core)
    anova(bdisp)

    # compute the ordination
    mds_dist <- pco(t(dat_filtered), distance = "bray")
    # test for difference due to depth and the interaction between depth and core
    adonis2(vegdist(t(dat_filtered), "bray") ~ depth, data = deep.dat.min15.bin53, permutations = 10000)

    # Plot the ordination
    pdf("~/Documents/DEEP-CORE/VARIABILITY/ANVIO-VARIABILITY-VISUALIZATION/VARIABILITY_s_SalMarSW160130MG_3_8917055_Bin_53-interactive/bin_53_ordination.pdf")
    ordiplot(mds_dist, disp = "sites", type = "t")
    ordihull(mds_dist, deep.dat.min15.bin53$core, label = TRUE)
    ordispider(mds_dist, deep.dat.min15.bin53$core)
    points(mds_dist, disp="sites", type = "p", cex=1.5, pch = 21)
    dev.off()

    # Plot the relationship between variability and depth for each core separately
    pdf("~/Documents/DEEP-CORE/VARIABILITY/ANVIO-VARIABILITY-VISUALIZATION/VARIABILITY_s_SalMarSW160130MG_3_8917055_Bin_53-interactive/bin_53_point_and_line.pdf", height = 5, width = 4)
    ggplot(deep.dat.min15.bin53, aes(x= depth, y = variability, fill = core))+
      geom_point(shape = 21, size = 3)+
      geom_smooth()+
      scale_x_reverse()+
      scale_fill_manual(values = c("blue", "green"))+
      coord_flip()+
      theme_minimal()
    dev.off()
  

    


